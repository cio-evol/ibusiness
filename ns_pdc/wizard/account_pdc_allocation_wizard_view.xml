<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_pdc_allocation_wizard" model="ir.ui.view">
        <field name="name">account.pdc.allocation.wizard.form</field>
        <field name="model">account.pdc.allocation.wizard</field>
        <field name="arch" type="xml">
            <form string="Allocate PDC to Invoices">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="pdc_id" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="partner_id" readonly="1"/>
                            <field name="move_type" invisible="1"/>
                        </group>
                        <group>
                            <field name="pdc_amount" readonly="1" string="PDC Total Amount"/>
                            <field name="already_allocated" readonly="1" string="Previously Allocated"/>
                            <field name="available_amount" readonly="1" decoration-info="available_amount > 0" string="Payment Residual Available"/>
                            <field name="total_allocation" readonly="1" decoration-warning="total_allocation > available_amount" string="Current Allocation Total"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Invoices" name="invoices" invisible="move_type != 'out_invoice'">
                            <field name="allocation_line_ids">
                                <list editable="bottom">
                                    <field name="invoice_id"
                                           domain="[('partner_id', '=', parent.partner_id), ('move_type', 'in', ['out_invoice', 'out_refund']), ('state', '=', 'posted'), ('payment_state', 'in', ('not_paid', 'partial')), ('amount_residual', '>', 0.01)]"/>
                                    <field name="invoice_amount" readonly="1"/>
                                    <field name="amount_allocate" sum="Total"/>
                                </list>
                            </field>
                        </page>

                        <page string="Bills" name="bills" invisible="move_type != 'in_invoice'">
                            <field name="allocation_line_ids">
                                <list editable="bottom">
                                    <field name="invoice_id"
                                           domain="[('partner_id', '=', parent.partner_id), ('move_type', 'in', ['in_invoice', 'in_refund']), ('state', '=', 'posted'), ('payment_state', 'in', ('not_paid', 'partial')), ('amount_residual', '>', 0.01)]"/>
                                    <field name="invoice_amount" readonly="1"/>
                                    <field name="amount_allocate" sum="Total"/>
                                </list>
                            </field>
                        </page>
                    </notebook>

                    <div class="alert alert-info" role="alert" invisible="available_amount &lt;= 0">
                        <strong>Payment Residual Available:</strong> <field name="available_amount" readonly="1"/>
                        <br/>This is the actual unreconciled amount remaining in the payment.
                        <br/>You can allocate up to this amount to invoices.
                    </div>

                    <div class="alert alert-warning" role="alert" invisible="total_allocation &lt;= available_amount">
                        <strong>Warning:</strong> Total allocation exceeds available amount!
                    </div>
                </sheet>

                <footer>
                    <button string="Allocate" name="action_allocate" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_account_pdc_allocation_wizard" model="ir.actions.act_window">
        <field name="name">Allocate PDC to Invoices</field>
        <field name="res_model">account.pdc.allocation.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_account_pdc_allocation_wizard"/>
    </record>
</odoo>