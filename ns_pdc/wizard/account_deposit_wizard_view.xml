<odoo>
    <record id="view_account_deposit_wizard" model="ir.ui.view">
        <field name="name">account.deposit.wizard.form</field>
        <field name="model">account.deposit.wizard</field>
        <field name="arch" type="xml">
            <form string="Account Deposit">
                <group>
                    <group>
                        <field name="bank_journal_id" required="1"/>
                        <field name="deposit_date" required="1"/>
                    </group>
                    <group>
                        <field name="bank_account_number" required="1"/>
                    </group>
                </group>
                <footer>
                    <button string="Deposit" type="object" name="action_deposit" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
