<?xml version="1.0"?>
<odoo>
    <record id="view_account_pdc_return_wizard" model="ir.ui.view">
        <field name="name">account.pdc.return.wizard.form</field>
        <field name="model">account.pdc.return.wizard</field>
        <field name="arch" type="xml">
            <form string="PDC Return">
                <group>
                    <group>
                        <field name="pdc_id" readonly="1"/>
                        <field name="return_date" required="1"/>
                    </group>
                    <group>
                        <field name="return_reason" placeholder="Enter reason for cheque return..."/>
                    </group>
                </group>
                <footer>
                    <button string="Confirm Return" type="object" name="action_confirm_return" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>