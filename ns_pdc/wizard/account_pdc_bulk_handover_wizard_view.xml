<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_pdc_bulk_handover_wizard_form" model="ir.ui.view">
        <field name="name">account.pdc.bulk.handover.wizard.form</field>
        <field name="model">account.pdc.bulk.handover.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk PDC Handover">
                <sheet>
                    <div class="oe_title">
                        <h1>Bulk PDC Handover</h1>
                        <p>Process handover of multiple cash cheques to a vendor without bill allocation.</p>
                    </div>

                    <group>
                        <group>
                            <field name="handover_to_partner_id" required="1"/>
                            <field name="handover_date"/>
                        </group>
                        <group>
                            <field name="pdc_count" readonly="1"/>
                            <field name="total_amount" readonly="1"/>
                        </group>
                    </group>

                    <div class="alert alert-info mt16 mb16" role="alert">
                        <strong>Info:</strong> This will create one payment for each PDC without bill allocation.
                        All PDCs will be handed over to the selected vendor on the specified date.
                    </div>

                    <notebook>
                        <page string="PDC Details">
                            <field name="pdc_line_ids" nolabel="1" readonly="1">
                                <list>
                                    <field name="pdc_id"/>
                                    <field name="partner_id"/>
                                    <field name="cheque_number"/>
                                    <field name="cheque_date"/>
                                    <field name="amount" sum="Total Amount"/>
                                    <field name="current_state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes" placeholder="Additional notes about the bulk handover..."/>
                        </page>
                    </notebook>

                    <!-- Hidden field for selected PDCs -->
                    <field name="pdc_ids" invisible="1"/>
                </sheet>

                <footer>
                    <button string="Process Bulk Handover" type="object" name="action_confirm"
                            class="btn-primary"
                            confirm="Are you sure you want to handover all selected PDCs? This will create individual payments for each PDC."/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action for bulk handover wizard -->
    <record id="action_account_pdc_bulk_handover_wizard" model="ir.actions.act_window">
        <field name="name">Bulk PDC Handover</field>
        <field name="res_model">account.pdc.bulk.handover.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>