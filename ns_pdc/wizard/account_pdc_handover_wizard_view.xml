<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- PDC Handover Wizard Form View -->
    <record id="view_account_pdc_handover_wizard_form" model="ir.ui.view">
        <field name="name">account.pdc.handover.wizard.form</field>
        <field name="model">account.pdc.handover.wizard</field>
        <field name="arch" type="xml">
            <form string="PDC Handover">
                <sheet>
                    <div class="oe_title">
                        <h1>Handover Cash Cheque</h1>
                        <p>Process handover of cash cheque to vendor. Bill allocation is optional.</p>
                    </div>

                    <group>
                        <group>
                            <field name="pdc_id" readonly="1"/>
                            <field name="handover_to_partner_id" required="1"/>
                            <field name="handover_date"/>
                        </group>
                        <group>
                            <field name="cheque_amount" readonly="1"/>
                            <field name="total_allocated" readonly="1"/>
                            <field name="remaining_amount" readonly="1"
                                   class="text-danger" invisible="remaining_amount == 0"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Bill Allocations (Optional)">
                            <div class="alert alert-info mb16" role="alert">
                                <strong>Optional:</strong> You can allocate this cheque to specific vendor bills, or leave it unallocated for later settlement.
                            </div>
                            <field name="allocation_ids">
                                <list editable="bottom">
                                    <field name="bill_id" required="1"/>
                                    <field name="amount" readonly="1"/>
                                    <field name="amount_allocate" required="1" sum="Total Allocation"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes" placeholder="Additional notes about the handover..."/>
                        </page>
                    </notebook>
                </sheet>

                <footer>
                    <button string="Process Handover" type="object" name="action_confirm"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- PDC Handover Confirmation Dialog -->
    <record id="view_account_pdc_handover_confirm_form" model="ir.ui.view">
        <field name="name">account.pdc.handover.confirm.form</field>
        <field name="model">account.pdc.handover.confirm</field>
        <field name="arch" type="xml">
            <form string="Remaining Amount Confirmation">
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        <strong>Remaining Amount Detected!</strong>
                    </div>

                    <group>
                        <field name="handover_to_partner_id" readonly="1"/>
                        <field name="remaining_amount" readonly="1"/>
                        <field name="handover_wizard_id" invisible="1"/>
                    </group>

                    <div class="mt16 mb16">
                        <p>
                            There is a remaining amount of <strong><field name="remaining_amount" readonly="1"/></strong>
                            after bill allocations for <strong><field name="handover_to_partner_id" readonly="1"/></strong>.
                        </p>
                        <p>
                            <strong>What would you like to do?</strong>
                        </p>
                        <ul>
                            <li><strong>Confirm with Remaining:</strong> Keep the remaining balance open for future bill settlements</li>
                            <li><strong>Cancel:</strong> Go back and adjust allocations to use the full amount</li>
                        </ul>
                    </div>
                </sheet>

                <footer>
                    <button string="Confirm with Remaining" type="object"
                            name="action_confirm_with_remaining" class="btn-primary"/>
                    <button string="Cancel" type="object" name="action_cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Handover Wizard Action -->
    <record id="action_account_pdc_handover_wizard" model="ir.actions.act_window">
        <field name="name">PDC Handover</field>
        <field name="res_model">account.pdc.handover.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>