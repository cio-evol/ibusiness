<?xml version="1.0"?>
<odoo>
    <record id="view_account_pdc_form" model="ir.ui.view">
        <field name="name">account.pdc.form</field>
        <field name="model">account.pdc</field>
        <field name="arch" type="xml">
            <form string="Account PDC">
                <header>
                    <button type="object" name="action_confirm" string="Confirm" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button type="object" name="action_deposited" string="Deposit" class="oe_highlight"
                            invisible="state != 'confirmed'"/>
                    <button type="object" name="action_handover" string="Handover" class="oe_highlight"
                            invisible="state != 'confirmed'"/>
                    <button type="object" name="action_realized" string="Realize" class="oe_highlight"
                            invisible="state != 'deposited'"/>
                    <button type="object" name="action_return" string="Return" class="oe_highlight"
                            invisible="state not in ('deposited', 'handover')"/>
                    <button type="object" name="action_allocate_invoices" string="Allocate Invoices" class="btn-secondary"
                            invisible="not (state == 'confirmed' and use_manual_amount and amount > 0)"/>
                    <button type="object" name="action_cancel" string="Cancel"
                            invisible="state != 'confirmed'"/>
                    <button type="object" name="action_reset_to_draft" string="Reset to Draft" class="btn-warning"
                            invisible="state in ('draft', 'canceled')"
                            groups="account.group_account_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,deposited,handover,realized"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_payments" type="object"
                                class="oe_stat_button" icon="fa-credit-card" invisible="account_payment_count == 0">
                            <field name="account_payment_count" widget="statinfo"
                                   string="Payments"/>
                        </button>
                        <button name="action_view_journal_entries" type="object"
                                class="oe_stat_button" icon="fa-bars" invisible="linked_journal_entry_count == 0">
                            <field name="linked_journal_entry_count" widget="statinfo"
                                   string="Journal Entries"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" required="1" readonly="state not in ('draft')"/>
                            <field name="cheque_date" required="1" readonly="state not in ('draft')"/>
                            <field name="chq_bank_id" required="1" readonly="state not in ('draft')"/>
                            <field name="cheque_number" required="1" readonly="state not in ('draft')"/>
                            <field name="customer_bank_account" readonly="state not in ('draft')"/>
                            <field name="created_date" readonly="state not in ('draft')"/>
                            <field name="reference" readonly="state not in ('draft')"/>
                        </group>
                        <group>
                            <field name="use_manual_amount" readonly="state not in ('draft')" string="Enter PDC Amount Manually"/>
                            <field name="manual_amount" invisible="not use_manual_amount" readonly="state not in ('draft')" required="use_manual_amount"/>
                            <field name="amount" invisible="use_manual_amount"/>
                            <field name="linked_journal_entry_ids" invisible="1"/>
                            <field name="has_unallocated_amount"/>
                            <field name="deposit_date" invisible="not deposit_date" readonly="1"/>
                            <field name="bank_journal_id" invisible="not bank_journal_id" readonly="1"/>
                            <field name="bank_account_number" invisible="not bank_account_number" readonly="1"/>
                            <field name="hand_over_to" readonly="state not in ('draft')"/>
                            <field name="handover_date" invisible="state != 'handover'" readonly="1"/>
                            <field name="handover_to_partner_id" invisible="state != 'handover'" readonly="1"/>
                            <field name="move_type" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Invoices" name="invoices" invisible="move_type != 'out_invoice'">
                            <div invisible="not use_manual_amount and state == 'draft'" class="alert alert-info" role="alert">
                                <strong>Manual Amount PDC:</strong> Invoice allocation is optional. You can confirm the PDC first and allocate invoices later using the "Allocate Invoices" button.
                            </div>
                            <field name="account_pdc_allocation_ids" required="not use_manual_amount" readonly="state not in ('draft')">
                                <list editable="bottom">
                                    <field name="invoice_id" required="1"
                                           domain="[('partner_id', '=', parent.partner_id), ('move_type', '=', 'out_invoice'), ('state', '=', 'posted'), ('payment_state', 'in', ('not_paid', 'partial'))]"/>
                                    <field name="partner_id"/>
                                    <field name="amount"/>
                                    <field name="amount_allocate" required="1" sum="Total"/>
                                </list>
                            </field>
                        </page>
                        <page string="Bills" name="bills" invisible="move_type != 'in_invoice'">
                            <div invisible="use_manual_amount and state == 'draft'" class="alert alert-info" role="alert">
                                <strong>Manual Amount PDC:</strong> Bill allocation is optional. You can confirm the PDC first and allocate bills later using the "Allocate Invoices" button.
                            </div>
                            <field name="account_pdc_allocation_ids" required="not use_manual_amount" readonly="state not in ('draft')">
                                <list editable="bottom">
                                    <field name="invoice_id" required="1"
                                           domain="[('partner_id', '=', parent.partner_id), ('move_type', '=', 'in_invoice'), ('state', '=', 'posted'), ('payment_state', 'in', ('not_paid', 'partial'))]"/>
                                    <field name="partner_id"/>
                                    <field name="amount"/>
                                    <field name="amount_allocate" required="1" sum="Total"/>
                                </list>
                            </field>
                        </page>
                        <page string="Handover Details" name="handover" invisible="state != 'handover'">
                            <group>
                                <field name="handover_to_partner_id"/>
                                <field name="handover_date"/>
                                <field name="handover_payment_id" readonly="1"/>
                            </group>
                            <field name="handover_notes" placeholder="Handover notes..."/>
                            <group string="Handover Breakdown">
                                <field name="handover_breakdown_ids" nolabel="1" readonly="1">
                                    <list>
                                        <field name="bill_id"/>
                                        <field name="partner_id"/>
                                        <field name="amount"/>
                                        <field name="amount_allocate" sum="Total Allocated"/>
                                        <field name="handover_date"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_account_pdc_tree" model="ir.ui.view">
        <field name="name">account.pdc.tree</field>
        <field name="model">account.pdc</field>
        <field name="arch" type="xml">
            <list default_order="id desc">
                <header>
                    <button type="object" name="action_deposited" string="Deposit" class="oe_highlight"/>
                    <button type="object" name="action_bulk_handover" string="Bulk Handover" class="btn-warning"
                            groups="account.group_account_manager"/>
                </header>
                <field name="name"/>
                <field name="cheque_date"/>
                <field name="cheque_number"/>
                <field name="chq_bank_id"/>
                <field name="amount"/>
                <field name="hand_over_to" optional="show"/>
                <field name="state" widget='badge' decoration-info="state == 'deposited'"
                       decoration-success="state == 'realized'" decoration-danger="state == 'return'"/>
            </list>
        </field>
    </record>

    <record id="view_account_pdc_search" model="ir.ui.view">
        <field name="name">account.pdc.search</field>
        <field name="model">account.pdc</field>
        <field name="arch" type="xml">
            <search>
                <field name="cheque_number" string="Number"/>
                <field name="reference"/>
                <field name="cheque_date" string="Date"/>
                <separator/>
                <filter name="filter_deposited" string="Deposited" domain="[('state', '=', 'deposited')]"/>
                <filter name="filter_realized" string="Realized" domain="[('state', '=', 'realized')]"/>
                <filter name="filter_return" string="Returned" domain="[('state', '=', 'return')]"/>
                <group expand="0" string="Group By">
                    <filter string="State" name="group_state" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Distribution Itinerary Action -->
    <record id="action_account_pdc" model="ir.actions.act_window">
        <field name="name">PDC</field>
        <field name="res_model">account.pdc</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first PDC record
            </p>
        </field>
    </record>

    <menuitem id="menu_action_account_chq_pdc" name="PD Cheques"
              action="action_account_pdc" sequence="16" parent="account.menu_finance_receivables"/>
</odoo>