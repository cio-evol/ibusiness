<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_move_form_inherit_pdc" model="ir.ui.view">
            <field name="name">account.move.form.inherit.pdc</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='preview_invoice']" position="after">
                    <button name="pay_by_cheque" string="Pay by Cheque" type="object"
                            class="btn-secondary" invisible="(
                                    state != 'posted'
                                    or payment_state not in ('not_paid', 'partial', 'in_payment')
                                    or move_type not in ('out_invoice', 'in_invoice')
                                )"/>
                </xpath>
                <xpath expr="//sheet/div[@name='button_box']//button[@name='action_open_business_doc']" position="after">
                    <button name="action_view_account_pdc" type="object" class="oe_stat_button" icon="fa-envelope-o" invisible="account_pdc_count == 0">
                        <field name="account_pdc_count" widget="statinfo" string="Cheques"/>
                    </button>
                </xpath>
                <xpath expr="//field[@name='amount_residual']" position="before">
                    <field name="total_pdc_amount" invisible="state != 'posted' or move_type not in ('out_invoice', 'in_invoice') or account_pdc_count == 0"/>
                </xpath>
            </field>
        </record>

        <record id="view_out_invoice_tree_inherit_pdc" model="ir.ui.view">
            <field name="name">account.move.tree.inherit.pdc</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_out_invoice_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//list/header/button[@name='action_force_register_payment']" position="after">
                    <button name="pay_by_cheque" string="Pay by Cheque" type="object"
                            class="btn-secondary"/>
                </xpath>
            </field>
        </record>

        <record id="view_out_invoice_bill_tree_inherit_pdc" model="ir.ui.view">
            <field name="name">account.move.invoice.bill.tree.inherit.pdc</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_in_invoice_bill_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//list/header/button[@name='action_force_register_payment']" position="after">
                    <button name="pay_by_cheque" string="Pay by Cheque" type="object"
                            class="btn-secondary"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
