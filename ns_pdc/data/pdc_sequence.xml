<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="pdc_cheque_payment_sequence" model="ir.sequence">
            <field name="name">PDC Cheque Payment Sequence</field>
            <field name="code">pdc.cheque.payment</field>
            <field name="prefix">PDC</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="pdc_cheque_bill_sequence" model="ir.sequence">
            <field name="name">PDC Cheque Vendor bill Sequence</field>
            <field name="code">pdc.cheque.bill</field>
            <field name="prefix">PDC/BILL/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>