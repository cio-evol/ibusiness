<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="group_ejari_user" model="res.groups">
        <field name="name">Ejari User</field>
    </record>

    <record id="group_ejari_manager" model="res.groups">
        <field name="name">Ejari Manager</field>
        <field name="implied_ids" eval="[(4, ref('dubai_ejari_management.group_ejari_user'))]"/>
    </record>

    <record id="ejari_record_multicompany_rule" model="ir.rule">
        <field name="name">Ejari multi-company access</field>
        <field name="model_id" ref="model_ejari_record"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', user.company_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('dubai_ejari_management.group_ejari_user')), (4, ref('dubai_ejari_management.group_ejari_manager'))]"/>
    </record>
</odoo>
