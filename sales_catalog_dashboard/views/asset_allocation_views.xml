<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Search view for Asset Allocations -->
    <record id="view_sales_catalog_asset_allocation_search" model="ir.ui.view">
        <field name="name">sales.catalog.asset.allocation.search</field>
        <field name="model">sales.catalog.asset.allocation</field>
        <field name="arch" type="xml">
            <search string="Asset Allocations">
                <field name="parent_product_id" string="Building/Property"/>
                <field name="asset_product_id" string="Asset"/>
            </search>
        </field>
    </record>

    <record id="view_sales_catalog_asset_allocation_list" model="ir.ui.view">
        <field name="name">sales.catalog.asset.allocation.list</field>
        <field name="model">sales.catalog.asset.allocation</field>
        <field name="arch" type="xml">
            <list string="Asset Allocations" editable="top" default_order="parent_product_id, id">
                <field name="parent_product_id" string="Building/Property" readonly="1" force_save="1"/>
                <field name="asset_product_id" readonly="add_qty_confirmed"/>
                <field name="asset_category_id" column_invisible="1"/>
                <field name="quantity" readonly="1" force_save="1"/>
                <field name="lot_ids" widget="many2many_tags" string="Lots/Serials" readonly="add_qty_confirmed"/>
                <field name="uom_id" readonly="add_qty_confirmed"/>
                <field name="add_qty_confirmed" column_invisible="1"/>
                <button name="action_add_assets" type="object" string="Add Qty" icon="fa-plus-circle" class="btn-primary" invisible="add_qty_confirmed"/>
            </list>
        </field>
    </record>

    <!-- Form view for Asset Allocation -->
    <record id="view_sales_catalog_asset_allocation_form" model="ir.ui.view">
        <field name="name">sales.catalog.asset.allocation.form</field>
        <field name="model">sales.catalog.asset.allocation</field>
        <field name="arch" type="xml">
            <form string="Allocation">
                <sheet>
                    <group>
                        <group>
                            <field name="parent_product_id" string="Building/Property" readonly="1"/>
                            <field name="asset_product_id" string="Asset" readonly="add_qty_confirmed"/>
                            <field name="asset_category_id" string="Category" invisible="1"/>
                            <field name="quantity" readonly="1"/>
                            <field name="uom_id" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="lot_ids" widget="many2many_tags" string="Lots/Serials" readonly="add_qty_confirmed" nolabel="1"/>
                        <field name="add_qty_confirmed" invisible="1"/>
                    </group>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_add_assets" type="object" string="Add Qty" icon="fa-plus-circle" class="btn-primary" invisible="add_qty_confirmed"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action: Assets Allocation -->
    <record id="action_sales_catalog_asset_allocation" model="ir.actions.act_window">
        <field name="name">Assets Allocation</field>
        <field name="res_model">sales.catalog.asset.allocation</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sales_catalog_asset_allocation_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No asset allocations yet.</p>
            <p>Add assets allocated to this property from the list.</p>
        </field>
    </record>
</odoo>
