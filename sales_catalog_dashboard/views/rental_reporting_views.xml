<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Graph View for Rental Analysis -->
    <record id="view_sale_rental_report_graph" model="ir.ui.view">
        <field name="name">sale.rental.report.graph</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <graph string="Rental Analysis" type="bar" sample="1" stacked="1">
                <field name="product_id"/>
                <field name="price_subtotal" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Search View for Rental Analysis -->
    <record id="view_sale_rental_report_search" model="ir.ui.view">
        <field name="name">sale.rental.report.search</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <search string="Rental Analysis">
                <field name="product_id"/>
            </search>
        </field>
    </record>

    <!-- Pivot View -->
    <record id="view_sale_rental_report_pivot" model="ir.ui.view">
        <field name="name">sale.rental.report.pivot</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <pivot string="Rental Analysis" sample="1">
                <field name="create_date" interval="month" type="row"/>
                <field name="product_id" type="col"/>
                <field name="price_subtotal" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Action -->
    <record id="action_rental_reporting" model="ir.actions.act_window">
        <field name="name">Rental Reporting</field>
        <field name="res_model">sale.order.line</field>
        <field name="view_mode">graph,pivot</field>
        <field name="domain">[('is_rental', '=', True), ('state', 'in', ['sale', 'done'])]</field>
        <field name="search_view_id" ref="view_sale_rental_report_search"/>
        <field name="context">{'search_default_group_product': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No rental data found to report on.
            </p>
        </field>
    </record>

    <!-- View Mappings -->
    <record id="action_rental_reporting_graph" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_sale_rental_report_graph"/>
        <field name="act_window_id" ref="action_rental_reporting"/>
    </record>

    <record id="action_rental_reporting_pivot" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_sale_rental_report_pivot"/>
        <field name="act_window_id" ref="action_rental_reporting"/>
    </record>

</odoo>
