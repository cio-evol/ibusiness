<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_schedule_wizard_form" model="ir.ui.view">
        <field name="name">product.schedule.wizard.form</field>
        <field name="model">product.schedule.wizard</field>
        <field name="arch" type="xml">
            <form string="Schedule — Select date range">
                <sheet>
                    <group>
                        <group string="Product">
                            <field name="product_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Select date range (Rental/Service duration)" colspan="2">
                        <div class="text-muted mb-2">
                            Choose start and end date/time. A new quotation will be created with this duration, one line (current product, qty 1). You can set the customer on the order.
                        </div>
                        <group>
                            <field name="start_datetime" string="Start" widget="datetime"/>
                            <field name="end_datetime" string="End" widget="datetime"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm" type="object" string="Create Quotation" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
