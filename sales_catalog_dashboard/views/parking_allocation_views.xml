<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Search view for Parking Allocations -->
    <record id="view_sales_catalog_parking_allocation_search" model="ir.ui.view">
        <field name="name">sales.catalog.parking.allocation.search</field>
        <field name="model">sales.catalog.parking.allocation</field>
        <field name="inherit_id" eval="False"/>
        <field name="arch" type="xml">
            <search string="Parking Allocations">
                <field name="parent_product_id" string="Building/Property"/>
                <field name="parking_product_id" string="Parking"/>
            </search>
        </field>
    </record>

    <!-- List view for Parking Allocations -->
    <record id="view_sales_catalog_parking_allocation_list" model="ir.ui.view">
        <field name="name">sales.catalog.parking.allocation.list</field>
        <field name="model">sales.catalog.parking.allocation</field>
        <field name="arch" type="xml">
            <list string="Parking Allocations" editable="top" create="1" default_order="parent_product_id, id">
                <field name="parent_product_id" string="Building/Property" readonly="1" force_save="1"/>
                <field name="parking_product_id" string="Parking" domain="[('categ_id.name', 'ilike', 'Parking')]"/>
                <field name="parking_category_id" column_invisible="1" readonly="1"/>
                <field name="quantity" readonly="1" force_save="1"/>
                <field name="lot_ids" widget="many2many_tags" string="Lots/Serials" readonly="1"/>
                <field name="uom_id" readonly="1"/>
                <field name="add_qty_confirmed" column_invisible="1"/>
                <button name="action_add_parking" type="object" string="Add Qty" icon="fa-plus-circle" class="btn-primary" invisible="add_qty_confirmed"/>
            </list>
        </field>
    </record>

    <!-- Form view for Parking Allocation -->
    <record id="view_sales_catalog_parking_allocation_form" model="ir.ui.view">
        <field name="name">sales.catalog.parking.allocation.form</field>
        <field name="model">sales.catalog.parking.allocation</field>
        <field name="inherit_id" eval="False"/>
        <field name="arch" type="xml">
            <form string="Parking Allocation">
                <sheet>
                    <group>
                        <group>
                            <field name="parent_product_id" string="Building/Property" readonly="1"/>
                            <field name="parking_product_id" string="Parking" domain="[('categ_id.name', 'ilike', 'Parking')]"/>
                            <field name="parking_category_id" string="Category" invisible="1" readonly="1"/>
                            <field name="quantity" readonly="1"/>
                            <field name="uom_id" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="lot_ids" widget="many2many_tags" string="Lots/Serials" readonly="1" nolabel="1"/>
                        <field name="add_qty_confirmed" invisible="1"/>
                    </group>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_add_parking" type="object" string="Add Qty" icon="fa-plus-circle" class="btn-primary" invisible="add_qty_confirmed"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action: Parking Allocations (separate model from Assets Allocation) -->
    <record id="action_sales_catalog_parking_allocation" model="ir.actions.act_window">
        <field name="name">Parking Allocations</field>
        <field name="res_model">sales.catalog.parking.allocation</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sales_catalog_parking_allocation_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No parking allocations yet.</p>
            <p>Add parking slots: use the list to add a line or open a record. Click "Add Qty" to assign serial numbers.</p>
        </field>
    </record>
</odoo>
