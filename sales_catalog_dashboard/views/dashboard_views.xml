<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Kanban View -->
    <record id="view_product_template_kanban_dashboard" model="ir.ui.view">
        <field name="name">product.product.kanban.dashboard</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1" create="0" delete="0" edit="0">
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_global_click">
                            <div class="row">
                                <div class="col-12">
                                    <strong><field name="name"/></strong>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-8">
                                    <div>Price: <field name="list_price"/></div>
                                    <div>Ref: <field name="default_code"/></div>
                                </div>
                                <div class="col-4 text-right">
                                    <field name="image_128" widget="image" class="oe_avatar"/>
                                </div>
                            </div>
                            <!-- Custom Tags logic if applicable -->
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                   <field name="type"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="currency_id" invisible="1"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_product_template_form_dashboard" model="ir.ui.view">
        <field name="name">product.product.form.dashboard</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <form string="Product Dashboard" create="0" delete="0" edit="1">
                <header>
                    <button name="action_field_visit" type="object" string="Field Visit" class="btn-primary"/>
                    <button name="action_help_desk" type="object" string="Help Desk" class="btn-secondary"/>
                    <button name="action_maintain" type="object" string="Maintain" class="btn-secondary"/>
                    
                    <button name="action_check_in" type="object" string="Check In"/>
                    <button name="action_check_out" type="object" string="Check out"/>
                    <button name="action_sign_agreement" type="object" string="Sign Agreement"/>
                    <button name="action_asset_allocations" type="object" string="Assets Allocation"/>
                    <button name="action_parking_allocations" type="object" string="Parking Allocations"/>
                </header>
                <sheet>
                    <field name="x_has_ongoing_booking" invisible="1"/>
                    <div class="ribbon ribbon-top-right" invisible="not x_has_ongoing_booking">
                        <span class="bg-success text-white fw-bold" style="font-size: 13px !important; white-space: nowrap !important; z-index: 10;">
                            <field name="x_current_booking_so"/>
                        </span>
                    </div>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_website_url" type="object" class="oe_stat_button" icon="fa-globe" string="Go To Website">
                        </button>
                        <button name="action_open_product_profile" type="object" class="oe_stat_button" icon="fa-user" string="Profile">
                        </button>
                        <button name="%(calendar.action_calendar_event)d" type="action" class="oe_stat_button" icon="fa-calendar" string="Calendar">
                        </button>
                        <button name="action_open_documents" type="object" class="oe_stat_button" icon="fa-file-text" string="Documents">
                        </button>
                        <button name="action_view_rental_schedule" type="object" class="oe_stat_button" icon="fa-tasks" string="Schedule">
                        </button>
                    </div>

                    <div class="container-fluid">
                        <!-- Top Row: Display Name -->
                        <div class="row mb-3">
                            <div class="col-12">
                                <label for="display_name" string="Display Name"/>
                                <h1>
                                    <field name="display_name" placeholder="Display Name" readonly="1"/>
                                </h1>
                            </div>
                        </div>

                        <!-- Middle Row: Charts and Image -->
                        <!-- Middle Row: Charts and Image -->
                        <div class="row mb-4">
                            <!-- Col 1: Stacked Graph (Rental Analysis) -->
                            <!-- Col 1: Stacked Graph (Rental Analysis) -->
                            <div class="col-4 p-3 border">
                                <div class="o_label mb-2"><strong>Rental Analysis (Stacked)</strong></div>
                                <field name="dashboard_rental_graph_data" widget="sales_catalog_dashboard_graph" graph_type="bar"/>
                            </div>

                            <!-- Col 2: Pie Chart (Rental State Distribution) -->
                            <div class="col-4 p-3 border">
                                <div class="o_label mb-2"><strong>Rental Status (Pie)</strong></div>
                                <field name="dashboard_rental_graph_data" widget="sales_catalog_dashboard_graph" graph_type="pie"/>
                            </div>

                            <!-- Col 3: Product Image -->
                            <div class="col-4 p-3 border text-center position-relative">
                                <!-- <div class="o_label mb-2"><strong>Product Image</strong></div> -->
                                <div class="o_dashboard_image_container d-flex justify-content-center align-items-center" style="height: 100%;">
                                    <field name="image_1920" widget="image" class="img-fluid oe_avatar_large" 
                                           style="max-height: 250px; width: auto;" 
                                           options="{'preview_image': 'image_128'}"/>
                                </div>
                            </div>
                        </div>

                        <!-- Bottom Row: Stats -->
                        <div class="row mb-3">
                            <!-- Revenue -->
                            <div class="col-3">
                                <div class="border p-3 text-center bg-light">
                                    <h3><field name="dashboard_revenue" widget="monetary" options="{'currency_field': 'currency_id'}"/></h3>
                                    <span>Revenue</span>
                                </div>
                            </div>
                            <!-- Cost -->
                            <div class="col-3">
                                <div class="border p-3 text-center bg-light">
                                    <h3><field name="dashboard_cost" widget="monetary" options="{'currency_field': 'currency_id'}"/></h3>
                                    <span>Cost</span>
                                </div>
                            </div>
                            <!-- Profit -->
                            <div class="col-3">
                                <div class="border p-3 text-center bg-light">
                                    <h3><field name="dashboard_profit" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/></h3>
                                    <span>Profit</span>
                                </div>
                            </div>
                            <!-- Current Owner -->
                            <div class="col-3">
                                <div class="border p-3 text-center bg-light">
                                    <h4><field name="current_owner_id" readonly="1"/></h4>
                                    <div class="mt-1" invisible="not x_current_booking_so">
                                        <span class="badge text-bg-primary"><field name="x_current_booking_so" readonly="1" nolabel="1"/></span>
                                    </div>
                                    <span>Current Owner</span>
                                </div>
                            </div>
                        </div>

                        <!-- Hidden Fields -->
                        <field name="currency_id" invisible="1"/>
                        <field name="company_id" invisible="1"/>
                        <field name="priority" invisible="1"/>
                    </div>

                    <!-- Notebook -->
                    <notebook>
                        <page string="Assets List" name="assets">
                            <field name="allocated_asset_ids" readonly="1">
                                <list string="Assets">
<!--                                    <field name="parent_product_id" string="Building/Property" readonly="1" force_save="1"/>-->
                                    <field name="asset_product_id" string="Asset Name" readonly="1"/>
                                    <field name="quantity" readonly="1" force_save="1" />
                                    <field name="lot_ids" widget="many2many_tags" string="Lots/Serials" readonly="1"/>
<!--                                    <button name="action_add_qty" type="object" string="Add Qty" icon="fa-plus-circle" class="btn-primary"/>-->
                                </list>
                            </field>
                        </page>
                        <page string="Parking Slots" name="parking_slots">
<!--                            <div class="mb-3">-->
<!--                                <strong>Parking Allocation Summary</strong>-->
<!--                                <span class="text-muted"> — Allocations for this property</span>-->
<!--                            </div>-->
                            <field name="allocated_parking_ids" readonly="1">
                                <list string="Parking Allocations" create="0" delete="0" edit="0">
                                    <field name="parent_product_id" string="Building/Property" optional="hide" column_invisible="1"/>
                                    <field name="parking_product_id" string="Parking"/>
                                    <field name="parking_category_id" string="Category" optional="hide"/>
                                    <field name="quantity" sum="Total Qty"/>
                                    <field name="uom_id" string="UoM"/>
                                    <field name="lot_ids" widget="many2many_tags" string="Lots/Serials"/>
                                    <field name="add_qty_confirmed" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Payments" name="payments">
                            <field name="product_payment_ids" readonly="1">
                                <list string="Payments">
                                    <field name="date"/>
                                    <field name="name"/>
                                    <field name="journal_id"/>
                                    <field name="partner_id"/>
                                    <field name="amount" sum="Total Amount"/>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="state" widget="badge" decoration-success="state == 'posted'" decoration-info="state == 'draft'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Rentals" name="rentals">
                            <field name="product_rental_history_ids" readonly="1">
                                <list string="Rental History">
                                    <field name="order_id" widget="many2one" string="Rental Reference"/>
                                    <field name="order_partner_id" string="Customer"/>
                                    <field name="start_date" string="Start Date"/>
                                    <field name="return_date" string="End Date"/>
                                    <field name="rental_status" string="Status" widget="badge" 
                                           decoration-info="rental_status == 'pickup'" 
                                           decoration-warning="rental_status == 'return'" 
                                           decoration-success="rental_status == 'returned'"/>
                                    <field name="invoice_status" widget="badge" decoration-success="invoice_status == 'invoiced'" decoration-info="invoice_status == 'to invoice'" optional="show"/>
                                    <field name="price_total" string="Total Amount" optional="show"/>
                                    <field name="state" invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Maintenance History" name="maintenance_history">
                            <field name="product_maintenance_ids" readonly="1">
                                <list string="Maintenance">
                                    <field name="name"/>
                                    <field name="equipment_id"/>
                                    <field name="user_id" string="Technician"/>
                                    <field name="stage_id"/>
                                    <field name="request_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Invoices" name="invoices">
                             <field name="product_invoice_ids" readonly="1">
                                <list string="Invoices">
                                    <field name="move_id" string="Invoice"/>
                                    <field name="partner_id"/>
                                    <field name="date"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="price_subtotal" sum="Total"/>
                                    <field name="currency_id" invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Sales Orders" name="sales_orders">
                            <field name="product_sale_order_ids" readonly="1">
                                <list string="Sales Orders">
                                    <field name="order_id" string="Order" widget="many2one"/>
                                    <field name="order_partner_id" string="Customer"/>
                                    <field name="create_date" string="Date"/>
                                    <field name="product_uom_qty" string="Quantity"/>
                                    <field name="price_unit" string="Price"/>
                                    <field name="price_subtotal" sum="Total"/>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="state" invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Bills" name="bills">
                            <field name="product_vendor_bill_ids" readonly="1">
                                <list string="Vendor Bills">
                                    <field name="move_id" string="Bill"/>
                                    <field name="partner_id" string="Vendor"/>
                                    <field name="date"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="price_subtotal" sum="Total"/>
                                </list>
                            </field>
                        </page>
                        <page string="Other Items" name="other_items">
                            <field name="other_item_ids">
                                <list string="Other Items" editable="bottom" create="1" delete="1">
                                    <field name="parent_product_id" column_invisible="1"/>
                                    <field name="product_id" string="Product"/>
                                    <field name="quantity" string="Qty"/>
                                    <field name="uom_id" string="Unit of Measure"/>
                                    <field name="price_unit" string="Price"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
<!--                 <div class="oe_chatter">-->
<!--                    <field name="message_follower_ids"/>-->
<!--                    <field name="activity_ids"/>-->
<!--                    <field name="message_ids"/>-->
<!--                </div>-->
            </form>
        </field>
    </record>



    <!-- Search View -->
    <record id="view_product_template_search_dashboard" model="ir.ui.view">
        <field name="name">product.product.search.dashboard</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <search string="Product Search">
                <field name="name"/>
                <field name="categ_id"/>
                <field name="default_code" string="Reference"/>
                <field name="product_variant_ids" string="Variants"/>
                <field name="all_product_tag_ids" string="Tags"/>
                <filter string="Category" name="categ_id" context="{'group_by':'categ_id'}"/>
                <searchpanel>
                    <field name="categ_id" string="CATEGORIES" icon="fa-th-list" enable_counters="1" hierarchize="1"/>
                    <field name="product_attribute_ids" string="VARIANTS" icon="fa-cubes" enable_counters="1" select="multi"/>
                    <field name="x_product_tag_ids" string="TAGS" icon="fa-tags" enable_counters="1" select="multi"/>
                </searchpanel>
            </search>
        </field>
    </record>


    <!-- List View -->
    <record id="view_product_template_tree_dashboard" model="ir.ui.view">
        <field name="name">product.product.list.dashboard</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <list string="Product Catalog" sample="1" multi_edit="1" create="0" delete="0" edit="0">
                <field name="priority" widget="priority" optional="show" readonly="1"/>
                <field name="name"/>
                <field name="default_code" optional="show"/>
                <field name="categ_id" optional="show"/>
                <field name="list_price" optional="show"/>
                <field name="standard_price" optional="hide"/>
                <field name="uom_id" optional="hide"/>
                <field name="type" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_sales_catalog_dashboard" model="ir.actions.act_window">
        <field name="name">Sales Catalog Dashboard</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('categ_id.visible_on_sales_catalog', '=', True)]</field>
        <field name="search_view_id" ref="view_product_template_search_dashboard"/>
        <field name="view_id" ref="view_product_template_kanban_dashboard"/>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Create your first Product in the Catalog Dashboard!
          </p>
        </field>
    </record>
    
    <!-- View Actions Mapping -->
    <record id="action_sales_catalog_dashboard_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_product_template_kanban_dashboard"/>
        <field name="act_window_id" ref="action_sales_catalog_dashboard"/>
    </record>
    
    <record id="action_sales_catalog_dashboard_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_product_template_form_dashboard"/>
        <field name="act_window_id" ref="action_sales_catalog_dashboard"/>
    </record>

    <record id="action_sales_catalog_dashboard_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_product_template_tree_dashboard"/>
        <field name="act_window_id" ref="action_sales_catalog_dashboard"/>
    </record>

</odoo>
