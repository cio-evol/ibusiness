<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Module Category -->
    <record id="module_category_property_asset" model="ir.module.category">
        <field name="name">Property and Asset Management</field>
        <field name="description">Property and Asset Management Application</field>
        <field name="sequence">50</field>
    </record>

    <!-- Privilege (required in Odoo 19 - links groups to category) -->
    <record id="privilege_property_asset" model="res.groups.privilege">
        <field name="name">Property and Asset Access</field>
        <field name="description">Access levels for Property and Asset Management</field>
        <field name="placeholder">No access</field>
        <field name="category_id" ref="module_category_property_asset"/>
        <field name="sequence">10</field>
    </record>

    <!-- User Groups -->
    <record id="group_property_asset_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_property_asset"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">User can view properties and assets, create maintenance requests</field>
    </record>

    <record id="group_property_asset_officer" model="res.groups">
        <field name="name">Officer</field>
        <field name="privilege_id" ref="privilege_property_asset"/>
        <field name="implied_ids" eval="[(4, ref('group_property_asset_user'))]"/>
        <field name="comment">Officer can manage asset assignments and maintenance</field>
    </record>

    <record id="group_property_asset_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_property_asset"/>
        <field name="implied_ids" eval="[(4, ref('group_property_asset_officer'))]"/>
        <field name="comment">Manager has full access to Property &amp; Asset Management</field>
    </record>

    <!-- Record Rules -->
    <!-- Property Rules -->
    <record id="property_comp_rule" model="ir.rule">
        <field name="name">Property: Multi-Company</field>
        <field name="model_id" ref="model_property_property"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Asset Assignment Rules -->
    <record id="asset_assignment_comp_rule" model="ir.rule">
        <field name="name">Asset Assignment: Multi-Company</field>
        <field name="model_id" ref="model_asset_assignment"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Asset Maintenance Rules -->
    <record id="asset_maintenance_comp_rule" model="ir.rule">
        <field name="name">Asset Maintenance: Multi-Company</field>
        <field name="model_id" ref="model_asset_maintenance"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Maintenance Request Rules -->
    <record id="maintenance_request_comp_rule" model="ir.rule">
        <field name="name">Maintenance Request: Multi-Company</field>
        <field name="model_id" ref="model_asset_maintenance_request"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <!-- User can only see their own maintenance requests -->
    <record id="maintenance_request_user_rule" model="ir.rule">
        <field name="name">Maintenance Request: User Own</field>
        <field name="model_id" ref="model_asset_maintenance_request"/>
        <field name="domain_force">[('requested_by_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_property_asset_user'))]"/>
    </record>

    <!-- Officers can see all maintenance requests -->
    <record id="maintenance_request_officer_rule" model="ir.rule">
        <field name="name">Maintenance Request: Officer All</field>
        <field name="model_id" ref="model_asset_maintenance_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_property_asset_officer'))]"/>
    </record>
</odoo>
