            <field name="name">IT Equipment</field>
            <field name="code">IT</field>
            <field name="sequence">10</field>
            <field name="description">Information Technology equipment</field>
            <field name="default_depreciation_years">3</field>
            <field name="requires_serial">True</field>
            <field name="requires_maintenance">True</field>
            <field name="maintenance_frequency">365</field>
        </record>

        <record id="asset_category_computer" model="asset.category">
