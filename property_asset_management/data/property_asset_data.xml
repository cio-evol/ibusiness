<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Property Types -->
        <record id="property_type_building" model="property.type">
            <field name="name">Building</field>
            <field name="code">BLDG</field>
            <field name="sequence">10</field>
            <field name="description">Physical building structure</field>
        </record>

        <record id="property_type_floor" model="property.type">
            <field name="name">Floor</field>
            <field name="code">FLR</field>
            <field name="sequence">20</field>
            <field name="parent_id" ref="property_type_building"/>
