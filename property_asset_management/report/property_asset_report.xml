<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Asset Report Action -->
    <record id="action_report_asset" model="ir.actions.report">
        <field name="name">Asset Report</field>
        <field name="model">product.template</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">property_asset_management.report_asset</field>
        <field name="report_file">property_asset_management.report_asset</field>
        <field name="print_report_name">'Asset - %s' % (object.name)</field>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Assignment Report Action -->
    <record id="action_report_assignment" model="ir.actions.report">
        <field name="name">Assignment Report</field>
        <field name="model">asset.assignment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">property_asset_management.report_assignment</field>
        <field name="report_file">property_asset_management.report_assignment</field>
        <field name="print_report_name">'Assignment - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_asset_assignment"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
