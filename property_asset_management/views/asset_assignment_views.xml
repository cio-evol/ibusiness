<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Asset Assignment Tree View -->
    <record id="view_asset_assignment_tree" model="ir.ui.view">
        <field name="name">asset.assignment.tree</field>
        <field name="model">asset.assignment</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'draft'" decoration-success="state == 'assigned'" decoration-muted="state == 'returned'" decoration-danger="state == 'cancelled'">
                <field name="name"/>
                <field name="asset_id"/>
                <field name="asset_code"/>
                <field name="asset_category_id" optional="show"/>
                <field name="property_id"/>
                <field name="property_type_id" optional="show"/>
                <field name="assigned_to_id" widget="many2one_avatar_user"/>
                <field name="assignment_date"/>
                <field name="expected_return_date" optional="show"/>
                <field name="actual_return_date" optional="show"/>
                <field name="condition_on_assignment" optional="hide"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'assigned'" decoration-muted="state == 'returned'" decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Asset Assignment Form View -->
    <record id="view_asset_assignment_form" model="ir.ui.view">
        <field name="name">asset.assignment.form</field>
        <field name="model">asset.assignment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" string="Confirm Assignment" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_return" string="Return Asset" type="object" class="btn-primary" invisible="state != 'assigned'"/>
                    <button name="action_acknowledge" string="Acknowledge" type="object" invisible="state != 'assigned' or acknowledged"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('returned', 'cancelled')"/>
                    <button name="action_draft" string="Reset to Draft" type="object" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,assigned,returned"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Asset Information">
                            <field name="asset_id" domain="[('is_asset', '=', True), ('asset_state', 'in', ['new', 'available'])]" readonly="state != 'draft'"/>
                            <field name="asset_code"/>
                            <field name="asset_category_id"/>
                        </group>
                        <group string="Assignment Details">
                            <field name="property_id" readonly="state != 'draft'"/>
                            <field name="property_type_id"/>
                            <field name="assigned_to_id" widget="many2one_avatar_user"/>
                            <field name="assigned_by_id" widget="many2one_avatar_user"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <group string="Dates">
                            <field name="assignment_date" readonly="state != 'draft'"/>
                            <field name="expected_return_date"/>
                            <field name="actual_return_date" readonly="state != 'assigned'"/>
                        </group>
                        <group string="Condition">
                            <field name="condition_on_assignment" readonly="state != 'draft'"/>
                            <field name="condition_on_return" readonly="state != 'assigned'" invisible="state == 'draft'"/>
                        </group>
                    </group>
                    <group>
                        <group string="Acknowledgment">
                            <field name="acknowledgment_required"/>
                            <field name="acknowledged" readonly="1"/>
                            <field name="acknowledged_date" invisible="not acknowledged"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="notes">
                            <group>
                                <field name="assignment_notes" placeholder="Notes about the assignment..."/>
                            </group>
                            <group invisible="state == 'draft'">
                                <field name="return_notes" placeholder="Notes about the return..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Asset Assignment Search View -->
    <record id="view_asset_assignment_search" model="ir.ui.view">
        <field name="name">asset.assignment.search</field>
        <field name="model">asset.assignment</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="asset_id"/>
                <field name="asset_code"/>
                <field name="property_id"/>
                <field name="assigned_to_id"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Assigned" name="assigned" domain="[('state', '=', 'assigned')]"/>
                <filter string="Returned" name="returned" domain="[('state', '=', 'returned')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="Pending Acknowledgment" name="pending_ack" domain="[('state', '=', 'assigned'), ('acknowledgment_required', '=', True), ('acknowledged', '=', False)]"/>
                <filter string="Overdue" name="overdue" domain="[('state', '=', 'assigned'), ('expected_return_date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter string="My Assignments" name="my_assignments" domain="[('assigned_to_id', '=', uid)]"/>
                <group>
                    <filter string="Asset" name="asset" context="{'group_by': 'asset_id'}"/>
                    <filter string="Asset Category" name="category" context="{'group_by': 'asset_category_id'}"/>
                    <filter string="Property" name="property" context="{'group_by': 'property_id'}"/>
                    <filter string="Property Type" name="property_type" context="{'group_by': 'property_type_id'}"/>
                    <filter string="Assigned To" name="assigned_to" context="{'group_by': 'assigned_to_id'}"/>
                    <filter string="Status" name="status" context="{'group_by': 'state'}"/>
                    <filter string="Assignment Date" name="assignment_date" context="{'group_by': 'assignment_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Asset Assignment Kanban View -->
    <record id="view_asset_assignment_kanban" model="ir.ui.view">
        <field name="name">asset.assignment.kanban</field>
        <field name="model">asset.assignment</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="name"/>
                <field name="asset_id"/>
                <field name="property_id"/>
                <field name="assigned_to_id"/>
                <field name="state"/>
                <field name="assignment_date"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between mb-2">
                            <field name="name" class="fw-bold"/>
                        </div>
                        <div>
                            <i class="fa fa-cube"/> <field name="asset_id"/>
                        </div>
                        <div>
                            <i class="fa fa-building"/> <field name="property_id"/>
                        </div>
                        <div class="text-muted">
                            <field name="assignment_date"/>
                        </div>
                        <footer class="pt-2">
                            <field name="assigned_to_id" widget="many2one_avatar_user"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Asset Assignment Action -->
    <record id="action_asset_assignment" model="ir.actions.act_window">
        <field name="name">Asset Assignments</field>
        <field name="res_model">asset.assignment</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_assigned': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first asset assignment
            </p>
            <p>
                Assign assets to properties and track their location and custody.
            </p>
        </field>
    </record>

    <!-- Quick Assignment Wizard Views -->
    <record id="view_asset_assignment_wizard_form" model="ir.ui.view">
        <field name="name">asset.assignment.wizard.form</field>
        <field name="model">asset.assignment.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="property_id"/>
                        <field name="assigned_to_id"/>
                        <field name="assignment_date"/>
                        <field name="expected_return_date"/>
                    </group>
                    <group>
                        <field name="condition_on_assignment"/>
                    </group>
                </group>
                <group string="Select Assets">
                    <field name="asset_ids" widget="many2many_tags"/>
                </group>
                <group>
                    <field name="notes"/>
                </group>
                <footer>
                    <button name="action_assign" string="Assign Assets" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Bulk Return Wizard Views -->
    <record id="view_asset_bulk_return_wizard_form" model="ir.ui.view">
        <field name="name">asset.bulk.return.wizard.form</field>
        <field name="model">asset.bulk.return.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="return_date"/>
                        <field name="condition_on_return"/>
                    </group>
                </group>
                <group string="Select Assignments to Return">
                    <field name="assignment_ids" widget="many2many_tags"/>
                </group>
                <group>
                    <field name="notes"/>
                </group>
                <footer>
                    <button name="action_return" string="Return Assets" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_asset_bulk_return" model="ir.actions.act_window">
        <field name="name">Bulk Return</field>
        <field name="res_model">asset.bulk.return.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
