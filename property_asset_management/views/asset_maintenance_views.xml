<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Asset Maintenance Tree View -->
    <record id="view_asset_maintenance_tree" model="ir.ui.view">
        <field name="name">asset.maintenance.tree</field>
        <field name="model">asset.maintenance</field>
        <field name="arch" type="xml">
            <list decoration-info="state in ('draft', 'scheduled')" decoration-warning="state == 'in_progress'" decoration-success="state == 'done'" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="asset_id"/>
                <field name="asset_code"/>
                <field name="maintenance_type"/>
                <field name="property_id" optional="show"/>
                <field name="scheduled_date"/>
                <field name="completion_date" optional="show"/>
                <field name="technician_id" widget="many2one_avatar_user"/>
                <field name="priority" widget="priority"/>
                <field name="cost" widget="monetary" optional="show"/>
                <field name="state" widget="badge" decoration-info="state in ('draft', 'scheduled')" decoration-warning="state == 'in_progress'" decoration-success="state == 'done'" decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Asset Maintenance Form View -->
    <record id="view_asset_maintenance_form" model="ir.ui.view">
        <field name="name">asset.maintenance.form</field>
        <field name="model">asset.maintenance</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_schedule" string="Schedule" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_start" string="Start Maintenance" type="object" class="btn-primary" invisible="state != 'scheduled'"/>
                    <button name="action_complete" string="Complete" type="object" class="btn-primary" invisible="state != 'in_progress'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('done', 'cancelled')"/>
                    <button name="action_draft" string="Reset to Draft" type="object" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,scheduled,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Asset Information">
                            <field name="asset_id" readonly="state != 'draft'"/>
                            <field name="asset_code"/>
                            <field name="asset_category_id"/>
                            <field name="property_id"/>
                        </group>
                        <group string="Maintenance Details">
                            <field name="maintenance_type" readonly="state not in ('draft', 'scheduled')"/>
                            <field name="priority" widget="priority"/>
                            <field name="technician_id" widget="many2one_avatar_user"/>
                            <field name="vendor_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <group string="Schedule">
                            <field name="scheduled_date" readonly="state not in ('draft', 'scheduled')"/>
                            <field name="completion_date" readonly="state != 'in_progress'"/>
                            <field name="duration"/>
                        </group>
                        <group string="Cost">
                            <field name="cost"/>
                            <field name="currency_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Describe the maintenance work to be performed..."/>
                        </page>
                        <page string="Work Performed" name="work" invisible="state == 'draft'">
                            <group>
                                <group string="Condition">
                                    <field name="condition_before"/>
                                    <field name="condition_after" invisible="state not in ('in_progress', 'done')"/>
                                </group>
                            </group>
                            <group>
                                <field name="work_performed"/>
                            </group>
                            <group>
                                <field name="parts_replaced"/>
                            </group>
                        </page>
                        <page string="Findings &amp; Recommendations" name="findings" invisible="state == 'draft'">
                            <group>
                                <field name="findings"/>
                            </group>
                            <group>
                                <field name="recommendations"/>
                            </group>
                        </page>
                        <page string="Documents" name="documents">
                            <field name="document_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Asset Maintenance Calendar View -->
    <record id="view_asset_maintenance_calendar" model="ir.ui.view">
        <field name="name">asset.maintenance.calendar</field>
        <field name="model">asset.maintenance</field>
        <field name="arch" type="xml">
            <calendar string="Maintenance Schedule" date_start="scheduled_date" color="maintenance_type" mode="month">
                <field name="name"/>
                <field name="asset_id"/>
                <field name="technician_id" widget="many2one_avatar_user"/>
            </calendar>
        </field>
    </record>

    <!-- Asset Maintenance Search View -->
    <record id="view_asset_maintenance_search" model="ir.ui.view">
        <field name="name">asset.maintenance.search</field>
        <field name="model">asset.maintenance</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="asset_id"/>
                <field name="asset_code"/>
                <field name="technician_id"/>
                <field name="vendor_id"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Scheduled" name="scheduled" domain="[('state', '=', 'scheduled')]"/>
                <filter string="In Progress" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="Preventive" name="preventive" domain="[('maintenance_type', '=', 'preventive')]"/>
                <filter string="Corrective" name="corrective" domain="[('maintenance_type', '=', 'corrective')]"/>
                <separator/>
                <filter string="Overdue" name="overdue" domain="[('state', 'in', ('scheduled', 'in_progress')), ('scheduled_date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="This Week" name="this_week" domain="[('scheduled_date', '&gt;=', (context_today() - datetime.timedelta(days=context_today().weekday())).strftime('%Y-%m-%d')), ('scheduled_date', '&lt;', (context_today() + datetime.timedelta(days=7-context_today().weekday())).strftime('%Y-%m-%d'))]"/>
                <filter string="This Month" name="this_month" domain="[('scheduled_date', '&gt;=', context_today().strftime('%Y-%m-01'))]"/>
                <separator/>
                <filter string="My Maintenance" name="my_maintenance" domain="[('technician_id', '=', uid)]"/>
                <group>
                    <filter string="Asset" name="asset" context="{'group_by': 'asset_id'}"/>
                    <filter string="Type" name="type" context="{'group_by': 'maintenance_type'}"/>
                    <filter string="Status" name="status" context="{'group_by': 'state'}"/>
                    <filter string="Technician" name="technician" context="{'group_by': 'technician_id'}"/>
                    <filter string="Priority" name="priority" context="{'group_by': 'priority'}"/>
                    <filter string="Scheduled Date" name="scheduled_date" context="{'group_by': 'scheduled_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Asset Maintenance Action -->
    <record id="action_asset_maintenance" model="ir.actions.act_window">
        <field name="name">Maintenance</field>
        <field name="res_model">asset.maintenance</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="context">{'search_default_scheduled': 1, 'search_default_in_progress': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first maintenance record
            </p>
            <p>
                Track preventive and corrective maintenance for your assets.
            </p>
        </field>
    </record>

    <!-- Maintenance Request Views -->
    <record id="view_maintenance_request_tree" model="ir.ui.view">
        <field name="name">asset.maintenance.request.tree</field>
        <field name="model">asset.maintenance.request</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'draft'" decoration-warning="state == 'submitted'" decoration-success="state in ('approved', 'maintenance_created')" decoration-danger="state == 'rejected'">
                <field name="name"/>
                <field name="asset_id"/>
                <field name="property_id"/>
                <field name="requested_by_id" widget="many2one_avatar_user"/>
                <field name="request_date"/>
                <field name="priority" widget="priority"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'submitted'" decoration-success="state in ('approved', 'maintenance_created')" decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_maintenance_request_form" model="ir.ui.view">
        <field name="name">asset.maintenance.request.form</field>
        <field name="model">asset.maintenance.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" string="Submit" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object" class="btn-primary" invisible="state != 'submitted'" groups="property_asset_management.group_property_asset_officer"/>
                    <button name="action_reject" string="Reject" type="object" invisible="state != 'submitted'" groups="property_asset_management.group_property_asset_officer"/>
                    <button name="action_create_maintenance" string="Create Maintenance" type="object" class="btn-primary" invisible="state != 'approved'" groups="property_asset_management.group_property_asset_officer"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,maintenance_created"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="asset_id" readonly="state != 'draft'"/>
                            <field name="property_id"/>
                            <field name="priority" widget="priority"/>
                        </group>
                        <group>
                            <field name="requested_by_id" widget="many2one_avatar_user"/>
                            <field name="request_date"/>
                            <field name="maintenance_id" invisible="not maintenance_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <field name="issue_description"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_maintenance_request_search" model="ir.ui.view">
        <field name="name">asset.maintenance.request.search</field>
        <field name="model">asset.maintenance.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="asset_id"/>
                <field name="requested_by_id"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Submitted" name="submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Rejected" name="rejected" domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter string="My Requests" name="my_requests" domain="[('requested_by_id', '=', uid)]"/>
                <group>
                    <filter string="Asset" name="asset" context="{'group_by': 'asset_id'}"/>
                    <filter string="Status" name="status" context="{'group_by': 'state'}"/>
                    <filter string="Priority" name="priority" context="{'group_by': 'priority'}"/>
                    <filter string="Requested By" name="requested_by" context="{'group_by': 'requested_by_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_maintenance_request" model="ir.actions.act_window">
        <field name="name">Maintenance Requests</field>
        <field name="res_model">asset.maintenance.request</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a maintenance request
            </p>
            <p>
                Report issues with assets that need maintenance attention.
            </p>
        </field>
    </record>
</odoo>
