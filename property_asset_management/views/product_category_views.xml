<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_category_form_inherit_property_sync" model="ir.ui.view">
        <field name="name">product.category.form.inherit.property.sync</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="sync_property" string="Is Property"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <group string="Assigned Assets" invisible="not sync_property">
                    <field name="asset_assignment_ids"
                           context="{'default_property_category_id': id}"
                           domain="[('state', 'in', ['draft', 'assigned'])]">
                        <list editable="bottom">
                            <field name="asset_id"/>
                            <field name="assigned_to_id" widget="many2one_avatar_user"/>
                            <field name="assignment_date"/>
                            <field name="expected_return_date"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_product_category_kanban_property_catalog" model="ir.ui.view">
        <field name="name">product.category.kanban.property.catalog</field>
        <field name="model">product.category</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile o_property_category_catalog" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="complete_name"/>
                <field name="parent_id"/>
                <field name="sync_property"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record">
                            <div class="d-flex gap-2 align-items-start">
                                <div class="flex-grow-1">
                                    <div class="fw-bold fs-5">
                                        <field name="name"/>
                                    </div>
                                    <div class="text-muted small" t-if="record.parent_id.raw_value">
                                        <i class="fa fa-folder-open me-1"/> <field name="parent_id"/>
                                    </div>
                                    <div class="mt-2">
                                        <span class="badge bg-light text-dark border">
                                            <i class="fa fa-home me-1"/> Property Category
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="mt-3 d-flex justify-content-between align-items-center">
                                <div class="btn-group">
                                    <a type="action"
                                       name="%(property_asset_management.action_asset_quick_assign)d"
                                       t-att-context="{'default_property_category_id': record.id.raw_value}"
                                       class="btn btn-sm btn-outline-primary">
                                        Assign Assets
                                    </a>
                                    <a type="action"
                                       name="%(property_asset_management.action_asset_transfer)d"
                                       t-att-context="{'default_source_property_id': record.id.raw_value}"
                                       class="btn btn-sm btn-outline-secondary">
                                        Transfer Assets
                                    </a>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_property_category_property_only" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">product.category</field>
        <field name="view_mode">kanban,form,list</field>
        <field name="domain">[('sync_property', '=', True)]</field>
        <field name="context">{'default_sync_property': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first property category
            </p>
            <p>
                Only categories marked as properties are shown here.
            </p>
        </field>
    </record>
</odoo>
